
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080f20">
<title>REDLINE — Own Your Momentum</title>
<style>
:root{
  --bg:#080f20;--panel:#101b31;--panel2:#14223b;
  --text:#edf3ff;--muted:#8b9ab4;--line:#263653;
  --red:#ed344f;--blue:#477bff;--soft:rgba(237,52,79,.13);
  --shadow:0 18px 50px rgba(0,0,0,.22);
}
body.light{
  --bg:#edf2fa;--panel:#fff;--panel2:#f4f7fc;
  --text:#17233b;--muted:#68758d;--line:#dce4f0;
  --shadow:0 15px 35px rgba(30,50,90,.08);
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:Inter,system-ui,Arial,sans-serif;
  transition:background .3s,color .3s;
}
button,input,textarea{font:inherit}
button{cursor:pointer}
.app{max-width:1450px;margin:auto;padding:22px}
header{
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;margin-bottom:28px
}
.logo{font-size:25px;font-weight:950;letter-spacing:3px}
.logo span{color:var(--red)}
.tagline{font-size:11px;color:var(--muted);letter-spacing:1.5px}
.profile{display:flex;align-items:center;gap:10px}
.avatar{
  width:40px;height:40px;border-radius:14px;
  background:linear-gradient(135deg,var(--red),#852b70);
  display:grid;place-items:center;font-weight:900
}
nav{
  display:flex;gap:8px;overflow-x:auto;padding:5px 0 17px;
  border-bottom:1px solid var(--line);margin-bottom:25px
}
nav button{
  flex-shrink:0;border:0;background:transparent;color:var(--muted);
  padding:11px 16px;border-radius:12px;font-weight:700;
  transition:.2s
}
nav button.active{background:var(--soft);color:var(--red)}
nav button:hover{background:var(--panel2);color:var(--text)}
button:active{transform:scale(.96)}
main{animation:appear .35s ease}
@keyframes appear{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:17px}
.card{
  background:var(--panel);border:1px solid var(--line);
  border-radius:20px;padding:21px;box-shadow:var(--shadow);
  min-width:0
}
.hero{
  grid-column:span 8;position:relative;overflow:hidden;
  background:linear-gradient(115deg,#111e39,#172c50 65%,#321c3b);
  min-height:220px
}
.hero:after{
  content:"";position:absolute;width:240px;height:240px;
  right:-60px;top:-90px;border:1px solid #ffffff20;
  border-radius:50%;box-shadow:0 0 0 25px #ffffff08,0 0 0 55px #ffffff05
}
.hero h1{font-size:clamp(28px,4vw,43px);margin:15px 0 8px}
.hero p{color:#aebbd2;max-width:440px;line-height:1.6}
.eyebrow{font-size:10px;letter-spacing:2px;color:var(--red);font-weight:900}
.stats{grid-column:span 4;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stat{background:var(--panel2);border-radius:15px;padding:16px}
.stat strong{font-size:26px;display:block;margin-top:7px}
.stat small{color:var(--muted)}
.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.section-title h2{font-size:17px;margin:0}
.tasks{grid-column:span 7}
.side{grid-column:span 5}
.full{grid-column:span 12}
.task{
  display:flex;align-items:center;gap:12px;padding:13px;
  border:1px solid var(--line);border-radius:13px;margin:9px 0;
  transition:.2s
}
.task:hover{border-color:var(--red);transform:translateX(3px)}
.task.done .task-name{text-decoration:line-through;color:var(--muted)}
.task input{accent-color:var(--red);width:18px;height:18px}
.task-name{flex:1;overflow-wrap:anywhere}
.delete{border:0;background:transparent;color:var(--muted);font-size:18px}
.btn{
  border:0;border-radius:12px;padding:11px 16px;
  font-weight:800;color:white;background:var(--red);
  transition:transform .18s,filter .18s;position:relative;overflow:hidden
}
.btn:hover{filter:brightness(1.12);transform:translateY(-2px)}
.btn.secondary{background:var(--panel2);color:var(--text);border:1px solid var(--line)}
.btn.blue{background:var(--blue)}
.btn.small{padding:8px 12px;font-size:12px}
input,textarea{
  background:var(--panel2);color:var(--text);
  border:1px solid var(--line);border-radius:11px;
  padding:12px;width:100%;outline:none
}
input:focus,textarea:focus{border-color:var(--red);box-shadow:0 0 0 3px var(--soft)}
.add-row{display:flex;gap:9px;margin-top:14px}
.add-row input{min-width:0}
.progress{height:9px;background:var(--panel2);border-radius:20px;overflow:hidden}
.progress div{height:100%;background:linear-gradient(90deg,var(--red),#ff8290);border-radius:20px;transition:width .6s}
.big-number{font-size:38px;font-weight:900}
.muted{color:var(--muted)}
.timer{text-align:center;padding:22px}
.timer-display{font-size:clamp(45px,8vw,72px);font-weight:900;letter-spacing:3px;margin:15px}
.setting-row{
  display:flex;align-items:center;justify-content:space-between;
  gap:15px;padding:17px 0;border-bottom:1px solid var(--line)
}
.setting-row:last-child{border:0}
.switch{accent-color:var(--red);width:22px;height:22px}
.pill{font-size:10px;padding:6px 9px;background:var(--soft);color:var(--red);border-radius:20px;font-weight:900}
.empty{text-align:center;padding:25px;color:var(--muted)}
.toast{
  position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);
  opacity:0;background:var(--panel2);border:1px solid var(--line);
  padding:12px 18px;border-radius:12px;transition:.25s;pointer-events:none;
  z-index:20
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.ripple{
  position:absolute;border-radius:50%;background:#ffffff55;
  transform:scale(0);animation:ripple .55s linear;pointer-events:none
}
@keyframes ripple{to{transform:scale(4);opacity:0}}
@media(max-width:760px){
 .app{padding:15px}
 .hero{grid-column:span 12}
 .stats{grid-column:span 12}
 .tasks,.side{grid-column:span 12}
 .card{padding:17px}
}
@media(prefers-reduced-motion:reduce){
 *,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>
<div class="app">
<header>
  <div>
    <div class="logo">RED<span>LINE</span></div>
    <div class="tagline">OWN YOUR MOMENTUM.</div>
  </div>
  <div class="profile">
    <div><b id="profileName">Operator</b><br><small class="muted">Personal workspace</small></div>
    <div class="avatar" id="avatar">R</div>
  </div>
</header>

<nav id="nav">
  <button class="active" data-tab="home">◈ Overview</button>
  <button data-tab="tasks">☷ Tasks</button>
  <button data-tab="focus">◷ Focus</button>
  <button data-tab="notes">▤ Notes</button>
  <button data-tab="settings">⚙ Settings</button>
</nav>
<main id="screen"></main>
</div>
<div class="toast" id="toast"></div>

<script>
const $=id=>document.getElementById(id);
const read=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key))??fallback}catch{return fallback}};
const save=(key,value)=>localStorage.setItem(key,JSON.stringify(value));

let tasks=read("redline23-tasks",[]);
let settings=read("redline23-settings",{name:"Operator",theme:"dark",target:120});
let notes=read("redline23-notes","");
let seconds=25*60,timer=null,running=false,tab="home";

function today(){return new Date().toLocaleDateString("en-CA")}
function done(){return tasks.filter(t=>t.done).length}
function percent(){return tasks.length?Math.round(done()/tasks.length*100):0}
function toast(message){
 $("toast").textContent=message;
 $("toast").classList.add("show");
 setTimeout(()=>$("toast").classList.remove("show"),2100);
}
function applySettings(){
 document.body.classList.toggle("light",settings.theme==="light");
 $("profileName").textContent=settings.name||"Operator";
 $("avatar").textContent=(settings.name||"R")[0].toUpperCase();
}
function taskMarkup(t){
 return `<div class="task ${t.done?"done":""}">
 <input type="checkbox" ${t.done?"checked":""} onchange="toggleTask('${t.id}')">
 <span class="task-name">${escapeHTML(t.text)}</span>
 <button class="delete" onclick="removeTask('${t.id}')" aria-label="Delete task">×</button>
 </div>`;
}
function escapeHTML(s){
 return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function addTask(){
 const field=$("newTask"),value=field.value.trim();
 if(!value)return;
 tasks.unshift({id:crypto.randomUUID?.()||String(Date.now()),text:value,done:false,date:today()});
 save("redline23-tasks",tasks);render();toast("Task added");
}
function toggleTask(id){
 tasks=tasks.map(t=>t.id===id?{...t,done:!t.done}:t);
 save("redline23-tasks",tasks);render();
}
function removeTask(id){
 tasks=tasks.filter(t=>t.id!==id);save("redline23-tasks",tasks);render();toast("Task removed");
}
function taskList(limit=100){
 const list=tasks.slice(0,limit);
 return list.length?list.map(taskMarkup).join(""):`<div class="empty">No tasks yet. Add one and get moving.</div>`;
}
function home(){
 return `
 <div class="grid">
  <section class="card hero">
   <div class="eyebrow">YOUR COMMAND CENTER</div>
   <h1>Make today<br>count.</h1>
   <p>Progress isn't a mood. It's a system. Take control of the next move.</p>
   <button class="btn" onclick="setTab('tasks')">View your tasks ↗</button>
  </section>
  <section class="stats">
   <div class="stat"><small>TASKS DONE</small><strong>${done()}</strong><small>of ${tasks.length} total</small></div>
   <div class="stat"><small>COMPLETION</small><strong>${percent()}%</strong><small>Today's progress</small></div>
   <div class="stat"><small>OPEN TASKS</small><strong>${tasks.length-done()}</strong><small>Still in play</small></div>
   <div class="stat"><small>FOCUS TARGET</small><strong>${settings.target}</strong><small>Minutes per day</small></div>
  </section>
  <section class="card tasks">
   <div class="section-title"><h2>Priority board</h2><span class="pill">LIVE</span></div>
   <div class="progress"><div style="width:${percent()}%"></div></div>
   <p class="muted">${percent()}% of your tasks completed</p>
   ${taskList(5)}
   <button class="btn secondary small" onclick="setTab('tasks')">All tasks →</button>
  </section>
  <section class="card side">
   <div class="section-title"><h2>Focus session</h2><span class="pill">25 MIN</span></div>
   <div class="timer">
    <div class="timer-display" id="miniTimer">25:00</div>
    <button class="btn" onclick="setTab('focus')">Start focusing →</button>
   </div>
   <p class="muted">Protect your attention. One session at a time.</p>
  </section>
  <section class="card full">
   <div class="section-title"><h2>Daily principle</h2><span class="eyebrow">REDLINE MINDSET</span></div>
   <h2>Consistency beats intensity.</h2>
   <p class="muted">Build a routine you can repeat. Small wins compound.</p>
  </section>
 </div>`;
}
function tasksPage(){
 return `<div class="grid">
 <section class="card full">
  <div class="section-title"><h2>Task management</h2><span class="pill">${tasks.length} TASKS</span></div>
  <div class="add-row">
   <input id="newTask" placeholder="Add a task..." maxlength="120" onkeydown="if(event.key==='Enter')addTask()">
   <button class="btn" onclick="addTask()">+ Add</button>
  </div>
  <div style="margin-top:20px">${taskList()}</div>
 </section></div>`;
}
function focusPage(){
 return `<div class="grid">
 <section class="card full timer">
  <div class="eyebrow">DEEP WORK MODE</div>
  <h2>Own your attention.</h2>
  <div class="timer-display" id="timerDisplay">${formatTime(seconds)}</div>
  <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap">
   <button class="btn" onclick="toggleTimer()" id="timerButton">${running?"Pause":"Start session"}</button>
   <button class="btn secondary" onclick="resetTimer()">Reset</button>
  </div>
  <p class="muted">25-minute focus session. Take a break when you finish.</p>
 </section></div>`;
}
function notesPage(){
 return `<div class="grid"><section class="card full">
 <div class="section-title"><h2>Quick notes</h2><span class="pill">AUTO-SAVE</span></div>
 <textarea id="notesArea" rows="12" placeholder="Ideas, reminders, plans...">${escapeHTML(notes)}</textarea>
 <p class="muted">Your notes are saved on this device as you type.</p>
 </section></div>`;
}
function settingsPage(){
 return `<div class="grid"><section class="card full">
 <div class="eyebrow">PERSONAL WORKSPACE</div><h2>Settings</h2>
 <div class="setting-row"><div><b>Display name</b><br><small class="muted">Shown in your workspace</small></div>
 <input id="nameInput" value="${escapeHTML(settings.name)}" style="max-width:190px"></div>
 <div class="setting-row"><div><b>Appearance</b><br><small class="muted">Choose your interface</small></div>
 <button class="btn secondary small" onclick="toggleTheme()">${settings.theme==="dark"?"Dark mode":"Light mode"}</button></div>
 <div class="setting-row"><div><b>Daily focus target</b><br><small class="muted">Minutes per day</small></div>
 <input id="targetInput" type="number" min="15" max="720" value="${settings.target}" style="max-width:100px"></div>
 <div class="setting-row"><div><b>Export backup</b><br><small class="muted">Download your tasks and settings</small></div>
 <button class="btn secondary small" onclick="backup()">Export</button></div>
 <div class="setting-row"><div><b>Import backup</b><br><small class="muted">Restore a previous Redline 2.3 backup</small></div>
 <input type="file" id="importFile" accept="application/json" style="max-width:190px" onchange="restoreBackup(event)"></div>
 <div class="setting-row"><div><b>Save preferences</b><br><small class="muted">Apply your changes</small></div>
 <button class="btn" onclick="saveSettings()">Save changes</button></div>
 <p class="muted">This version stores data locally in this browser. It does not have online accounts or cloud syncing.</p>
 </section></div>`;
}
function formatTime(s){return `${String(Math.floor(s/60)).padStart(2,"0")}:${String(s%60).padStart(2,"0")}`}
function toggleTimer(){
 if(running){clearInterval(timer);running=false;render();return}
 running=true;
 timer=setInterval(()=>{
  seconds--;
  if(seconds<=0){clearInterval(timer);running=false;seconds=0;toast("Focus session complete!");}
  const el=$("timerDisplay");if(el)el.textContent=formatTime(seconds);
 },1000);
 render();
}
function resetTimer(){
 clearInterval(timer);running=false;seconds=25*60;render();
}
function toggleTheme(){
 settings.theme=settings.theme==="dark"?"light":"dark";
 save("redline23-settings",settings);applySettings();render();
}
function saveSettings(){
 const name=$("nameInput").value.trim()||"Operator";
 const target=Math.max(15,Math.min(720,Number($("targetInput").value)||120));
 settings={...settings,name,target};
 save("redline23-settings",settings);applySettings();render();toast("Settings saved");
}
function backup(){
 const data={version:1,tasks,settings,notes};
 const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
 const url=URL.createObjectURL(blob);
 const a=document.createElement("a");a.href=url;a.download="redline-backup.json";a.click();
 URL.revokeObjectURL(url);toast("Backup exported");
}
function restoreBackup(event){
 const file=event.target.files[0];if(!file)return;
 const reader=new FileReader();
 reader.onload=()=>{
  try{
   const data=JSON.parse(reader.result);
   if(!Array.isArray(data.tasks)||!data.settings)throw Error();
   tasks=data.tasks;settings={...settings,...data.settings};notes=data.notes||"";
   save("redline23-tasks",tasks);save("redline23-settings",settings);save("redline23-notes",notes);
   applySettings();render();toast("Backup restored");
  }catch{toast("Invalid backup file")}
 };
 reader.readAsText(file);
}
function render(){
 applySettings();
 const pages={home,tasks:tasksPage,focus:focusPage,notes:notesPage,settings:settingsPage};
 $("screen").innerHTML=pages[tab]();
 document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("active",b.dataset.tab===tab));
 if(tab==="notes")$("notesArea").addEventListener("input",e=>{notes=e.target.value;save("redline23-notes",notes)});
}
function setTab(name){tab=name;render()}
document.querySelectorAll("nav button").forEach(b=>b.addEventListener("click",()=>setTab(b.dataset.tab)));
document.addEventListener("click",e=>{
 const b=e.target.closest("button");if(!b||matchMedia("(prefers-reduced-motion: reduce)").matches)return;
 const r=document.createElement("span");r.className="ripple";
 const rect=b.getBoundingClientRect(),size=Math.max(rect.width,rect.height);
 r.style.width=r.style.height=size+"px";
 r.style.left=(e.clientX-rect.left-size/2)+"px";
 r.style.top=(e.clientY-rect.top-size/2)+"px";
 b.appendChild(r);setTimeout(()=>r.remove(),600);
});
applySettings();render();
</script>
</body>
</html>
