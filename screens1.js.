window.__p=2;
// BACKUP / RESTORE
function exportData(){const data={tasks,cats,focus,exams,notes,events,xp,coins,xpAwards,owned,avatar,challenges,completedDays,weeklyGoal,profileName,reducedMotion};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='redline-backup.json';a.click();URL.revokeObjectURL(url);toast('Backup exported')}
function importData(input){const file=input.files?.[0];if(!file)return;if(!confirm('Restoring replaces ALL current data. Continue?')){input.value='';return}const reader=new FileReader();reader.onload=()=>{try{const d=JSON.parse(reader.result);tasks=Array.isArray(d.tasks)?d.tasks:[];cats=Array.isArray(d.cats)?d.cats:cats;focus=d.focus||{};exams=d.exams||[];notes=d.notes||{};events=d.events||[];xp=Number(d.xp)||0;coins=Number(d.coins)||0;xpAwards=d.xpAwards||{};owned=d.owned||['default'];avatar=d.avatar||'default';challenges=d.challenges||[];completedDays=d.completedDays||[];weeklyGoal=Number(d.weeklyGoal)||20;profileName=String(d.profileName||profileName||'Operator');reducedMotion=Boolean(d.reducedMotion);ensureRecurringSchedule();applyTheme();save();render();toast('Backup restored')}catch(e){toast('Invalid backup file')}};reader.readAsText(file)}

// NAVIGATION / RENDER
function renderNav(){$('nav').innerHTML=NAV.map(n=>`<button class="${tab===n[0]?'active':''}" onclick="go('${n[0]}')"><span>${n[1]}</span>${n[2]}</button>`).join('')}
function render(){renderNav();$('levelPill').textContent=`LEVEL ${level()} · ${xp} XP`;const screens={today:renderToday,calendar:renderCalendar,focus:renderFocus,progress:renderStats,more:renderMore,settings:renderSettings};try{(screens[tab]||renderToday)()}catch(err){console.error(err);$('screen').innerHTML=`<section class="card"><h2>This screen hit an error</h2><p class="muted">${escapeHTML(err.message)}</p><button class="primary block" onclick="go('today')">Back to Today</button></section>`}}

// DASHBOARD HELPERS (2.4)
function ring(p){const r=52,c=2*Math.PI*r;return `<svg class="ring" width="124" height="124" viewBox="0 0 120 120"><circle cx="60" cy="60" r="${r}" fill="none" stroke="var(--panel2)" stroke-width="10"/><circle cx="60" cy="60" r="${r}" fill="none" stroke="var(--red)" stroke-width="10" stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${c*(1-p/100)}" transform="rotate(-90 60 60)" style="transition:stroke-dashoffset .6s"/><text x="60" y="67" text-anchor="middle" fill="var(--ink)" font-size="24" font-weight="900">${p}%</text></svg>`}
function greeting(){const h=new Date().getHours();return h<12?'Good morning':h<18?'Good afternoon':'Good evening'}
function quickNote(){selectedDate=todayKey();editingNote=true;tab='today';render();setTimeout(()=>$('noteInput')?.focus(),60)}
function dashTop(key,list,done,percent){
const wk=(Array.from({length:7},(_,i)=>focus[addDays(todayKey(),-i)]||0).reduce((a,b)=>a+b,0)/3600).toFixed(1);
const pri=list.filter(t=>!t.done).sort((a,b)=>(b.pri||0)-(a.pri||0)).slice(0,3);
const dl=exams.filter(e=>e.date>=todayKey()).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,3);
return `<div class="page-heading"><div class="eyebrow">${greeting()}, ${escapeHTML(profileName)}</div><h1>${key===todayKey()?'Command centre.':'Your schedule.'}</h1><p class="muted">${formatDate(key,{weekday:'long',month:'long',day:'numeric',year:'numeric'})} · ${new Date().toLocaleTimeString('en-IN',{hour:'numeric',minute:'2-digit'})}</p></div>
<section class="hero"><div class="dash">${ring(percent)}<div><div class="eyebrow">DAILY PROGRESS</div><h1>${done}<span> / ${list.length}</span></h1><p>Tasks completed</p></div></div><div class="progress-track"><i style="width:${levelXP()}%"></i></div><div class="muted small">Level ${level()} · ${levelXP()} / 100 XP</div></section>
<div class="tiles"><div class="tile"><span class="eyebrow">STREAK</span><b>${streak()} 🔥</b></div><div class="tile"><span class="eyebrow">FOCUS TODAY</span><b>${totalFocus(todayKey())}m</b></div><div class="tile"><span class="eyebrow">7 DAYS</span><b>${wk}h</b></div></div>
<div class="qa"><button onclick="openTaskModal()"><span>＋</span>Task</button><button onclick="go('focus')"><span>◷</span>Focus</button><button onclick="openEventModal()"><span>▦</span>Event</button><button onclick="quickNote()"><span>✎</span>Note</button></div>
<div class="section-head"><h2>Priorities</h2></div><section class="card">${pri.length?pri.map(t=>`<div class="task"><div class="task-name">${escapeHTML(t.text)}<small>${escapeHTML(t.cat)} · ${['Normal','Important','High'][t.pri||0]}</small></div></div>`).join(''):'<div class="empty">Nothing pending. Clear skies.</div>'}</section>
<div class="section-head"><h2>Upcoming deadlines</h2></div><section class="card">${dl.length?dl.map(e=>{const d=Math.ceil((fromKey(e.date)-fromKey(todayKey()))/86400000);return `<div class="task"><div class="task-name">🎓 ${escapeHTML(e.name)}<small>${formatDate(e.date)} · ${d===0?'Today':d+' days left'}</small></div></div>`}).join(''):'<div class="empty">No deadlines ahead.</div>'}</section>`}
function catBreakdown(){const m={};tasks.filter(t=>t.done).forEach(t=>m[t.cat]=(m[t.cat]||0)+1);const e=Object.entries(m).sort((a,b)=>b[1]-a[1]);if(!e.length)return '<section class="card"><h2>By category</h2><div class="empty">Complete tasks to see your breakdown.</div></section>';const tot=e.reduce((a,x)=>a+x[1],0);let acc=0;const stops=e.map((x,i)=>{const s0=acc/tot*100;acc+=x[1];return `${COLORS[i%COLORS.length]} ${s0}% ${acc/tot*100}%`}).join(',');const mk='radial-gradient(circle 36px,transparent 97%,#000 100%)';return `<section class="card"><h2>By category</h2><div class="dash"><div style="flex:none;width:120px;height:120px;border-radius:50%;background:conic-gradient(${stops});-webkit-mask:${mk};mask:${mk}"></div><div>${e.map((x,i)=>`<div class="muted"><span style="color:${COLORS[i%COLORS.length]}">●</span> ${escapeHTML(x[0])} · ${x[1]}</div>`).join('')}</div></div></section>`}

// TODAY
function renderToday(){const key=selectedDate,list=dayTasks(key),done=list.filter(t=>t.done).length,percent=list.length?Math.round(done/list.length*100):0;const start=new Date();start.setDate(start.getDate()-start.getDay());const week=Array.from({length:7},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);return d});
const dateButtons=week.map(d=>{const k=dateKey(d),count=dayTasks(k).filter(t=>t.done).length;return `<button class="date-btn ${k===key?'active':''}" onclick="chooseDate('${k}')"><span>${d.toLocaleDateString('en-IN',{weekday:'short'})}</span><b>${d.getDate()}</b><i>${count?count+' ✓':''}</i></button>`}).join('');
const taskHTML=list.length?list.map(t=>`<div class="task ${t.done?'done':''}"><input type="checkbox" ${t.done?'checked':''} onchange="toggleTask('${t.id}')"><div class="task-name">${escapeHTML(t.text)}<small>${escapeHTML(t.cat)} · ${['Normal','Important','High'][t.pri||0]}</small></div><button class="delete" onclick="deleteTask('${t.id}')">×</button></div>`).join(''):'<div class="empty">No tasks scheduled for this day.</div>';
const note=notes[key]||'',dayEvents=eventsOn(key);
$('screen').innerHTML=`${dashTop(key,list,done,percent)}
<div class="date-strip">${dateButtons}</div>
<div class="section-head"><h2>Tasks</h2><button class="primary" onclick="openTaskModal()">+ Add task</button></div><section class="card">${taskHTML}</section>
<div class="section-head"><h2>Events</h2><button class="secondary" onclick="openEventModal()">+ Event</button></div><section class="card">${dayEvents.length?dayEvents.map(e=>`<div class="event-card"><div class="event-color" style="background:${e.color}"></div><div class="event-content"><b>${escapeHTML(e.name)}</b><div class="muted">${formatTime(e.time)} – ${formatTime(e.endTime)} · ${escapeHTML(e.category)}</div>${e.location?`<div class="muted">📍 ${escapeHTML(e.location)}</div>`:''}</div><button class="delete" onclick="openEventModal('${e.id}')">✎</button></div>`).join(''):'<div class="empty">Nothing scheduled.</div>'}</section>
<div class="section-head"><h2>Daily note</h2></div><section class="card">${note&&!editingNote?`<div class="note-card">${escapeHTML(note)}<button class="note-edit" onclick="editNote()">✎</button></div>`:`<textarea id="noteInput" placeholder="Write down your thoughts, plans or daily summary...">${escapeHTML(note)}</textarea><button class="primary block" onclick="saveNote()">Save note</button>${note?'<button class="secondary block" onclick="cancelNoteEdit()">Cancel</button>':''}`}</section>
<section class="card"><div class="eyebrow">DAILY REMINDER</div><div class="quote">"${QUOTES[currentQuote%QUOTES.length]}"</div><button class="secondary block" onclick="newQuote()">↻ New quote</button></section>`}

// CALENDAR
function renderCalendar(){const monthName=calendarMonth.toLocaleDateString('en-IN',{month:'long',year:'numeric'}),viewButtons=['month','week','day','agenda'].map(v=>`<button class="${calendarView===v?'active':''}" onclick="setCalendarView('${v}')">${v[0].toUpperCase()+v.slice(1)}</button>`).join('');let content='';
if(calendarView==='month'){const first=new Date(calendarMonth.getFullYear(),calendarMonth.getMonth(),1),gridStart=new Date(first);gridStart.setDate(1-first.getDay());let cells='';
for(let i=0;i<42;i++){const d=new Date(gridStart);d.setDate(gridStart.getDate()+i);const key=dateKey(d),de=eventsOn(key),dt=dayTasks(key),ex=exams.filter(x=>x.date===key);cells+=`<button class="month-cell ${d.getMonth()!==calendarMonth.getMonth()?'outside':''} ${key===selectedDate?'selected':''} ${key===todayKey()?'today':''}" onclick="chooseDate('${key}')" ondragover="allowDrop(event)" ondrop="dropEvent(event,'${key}')"><span class="day-number">${d.getDate()}</span>${de.slice(0,2).map(e=>`<span class="event-dot" style="background:${e.color};color:#101114" draggable="true" ondragstart="dragEvent(event,'${e.id}')">${escapeHTML(e.name)}</span>`).join('')}${dt.length?`<span class="event-dot task-dot">${dt.length} tasks</span>`:''}${ex.map(e=>`<span class="event-dot exam-dot">🎓 ${escapeHTML(e.name)}</span>`).join('')}${de.length>2?`<span class="small muted">+${de.length-2} more</span>`:''}</button>`}
content=`<div class="cal-weekdays">${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div>${d}</div>`).join('')}</div><div class="month-grid">${cells}</div><div class="muted small" style="margin-top:12px">Select a date to see its tasks and events. Drag events to reschedule on desktop.</div>`}
if(calendarView==='week'||calendarView==='day'){const start=fromKey(selectedDate);if(calendarView==='week')start.setDate(start.getDate()-start.getDay());const days=calendarView==='week'?7:1;
content=`<div class="calendar-day-list" style="margin-bottom:12px">${Array.from({length:days},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);const k=dateKey(d);return `<button class="secondary" onclick="chooseDate('${k}')">${formatDate(k,{weekday:'short',month:'short',day:'numeric'})}${k===selectedDate?' · Selected':''}</button>`}).join('')}</div>
<div class="time-grid"><div class="time-grid-inner">${Array.from({length:18},(_,i)=>`<div class="time-row"><div class="time-label">${formatTime(`${pad(i+6)}:00`)}</div><div class="time-slot"></div></div>`).join('')}
${Array.from({length:days},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);return eventsOn(dateKey(d)).map(e=>{const [h,m]=(e.time||'09:00').split(':').map(Number),[eh,em]=(e.endTime||'10:00').split(':').map(Number),top=(h-6)*58+m/60*58,height=Math.max(30,((eh-h)+(em-m)/60)*58);if(top<0||top>1044)return '';return `<div class="time-event" style="top:${top}px;height:${height}px;background:${e.color}33;border-color:${e.color};left:${64+i*100/days}%;right:${Math.max(5,(days-i-1)*100/days)}%" onclick="openEventModal('${e.id}')"><b>${escapeHTML(e.name)}</b><br>${formatTime(e.time)}</div>`}).join('')}).join('')}</div></div><button class="primary block" onclick="openEventModal()">+ Add event</button>`}
if(calendarView==='agenda'){let rows='';for(let i=0;i<90;i++){const k=addDays(todayKey(),i),de=eventsOn(k),dt=dayTasks(k),dx=exams.filter(e=>e.date===k);if(!de.length&&!dt.length&&!dx.length)continue;rows+=`<div class="agenda-date">${formatDate(k,{weekday:'long',month:'long',day:'numeric'})}</div>${de.map(e=>`<div class="event-card"><div class="event-color" style="background:${e.color}"></div><div class="event-content"><b>${escapeHTML(e.name)}</b><div class="muted">${formatTime(e.time)} – ${formatTime(e.endTime)}</div></div><button class="delete" onclick="openEventModal('${e.id}')">✎</button></div>`).join('')}${dt.map(t=>`<div class="event-card"><div class="event-color" style="background:var(--green)"></div><div class="event-content"><b>${escapeHTML(t.text)}</b><div class="muted">Task · ${t.done?'Completed':'Pending'}</div></div></div>`).join('')}${dx.map(e=>`<div class="event-card"><div class="event-color" style="background:var(--amber)"></div><div class="event-content"><b>🎓 ${escapeHTML(e.name)}</b></div></div>`).join('')}`}content=rows||'<div class="empty">No upcoming items in the next 90 days.</div>'}
const selectedEvents=eventsOn(selectedDate);
$('screen').innerHTML=`<div class="page-heading"><div class="eyebrow">PLAN YOUR TIME</div><h1>Calendar.</h1><p class="muted">Your tasks, events and schedule in one place.</p></div>
<section class="card"><div class="calendar-toolbar"><div class="calendar-controls"><button class="secondary" onclick="changeCalendar(-1)">‹</button><button class="secondary" onclick="calendarToday()">Today</button><button class="secondary" onclick="changeCalendar(1)">›</button></div><h2>${monthName}</h2><button class="primary" onclick="openEventModal()">+ Event</button></div>
<div class="section-head"><div class="view-switch">${viewButtons}</div></div>
<div class="field"><input id="calendarSearch" placeholder="Search events..." value="${escapeHTML(calendarSearch)}" oninput="setCalendarSearch(this.value)"></div>
<div class="field"><select onchange="setCalendarFilter(this.value)">${['All','Personal','School','Work','Fitness','Other'].map(c=>`<option ${calendarFilter===c?'selected':''}>${c}</option>`).join('')}</select></div>${content}</section>
<div class="section-head"><h2>${formatDate(selectedDate,{weekday:'short',month:'short',day:'numeric'})}</h2><button class="secondary" onclick="openEventModal()">+ Add</button></div>
<section class="card">${selectedEvents.length?selectedEvents.map(e=>`<div class="event-card"><div class="event-color" style="background:${e.color}"></div><div class="event-content"><b>${escapeHTML(e.name)}</b><div class="muted">${formatTime(e.time)} – ${formatTime(e.endTime)}</div><div class="muted">${escapeHTML(e.category)} ${e.location?'· '+escapeHTML(e.location):''}</div>${e.description?`<p class="muted">${escapeHTML(e.description)}</p>`:''}${eventConflicts(e)?'<span class="small" style="color:var(--amber)">⚠ Time conflict</span>':''}</div><div class="event-actions"><button class="secondary" onclick="openEventModal('${e.id}')">Edit</button><button class="danger" onclick="deleteEvent('${e.id}')">×</button></div></div>`).join(''):'<div class="empty">No events on this date.</div>'}</section>
<div class="section-head"><h2>Exams & deadlines</h2></div><section class="card"><div class="field"><label>EXAM OR DEADLINE</label><input id="examName" placeholder="e.g. Mathematics exam"></div><div class="field"><label>DATE</label><input id="examDate" type="date"></div><button class="secondary block" onclick="addExam()">Add deadline</button>
${[...exams].sort((a,b)=>a.date.localeCompare(b.date)).map(e=>{const days=Math.ceil((fromKey(e.date)-fromKey(todayKey()))/86400000);return `<div class="event-card"><div class="event-content"><b>🎓 ${escapeHTML(e.name)}</b><div class="muted">${formatDate(e.date)} · ${days<0?'Passed':days===0?'Today':days+' days left'}</div></div><button class="delete" onclick="deleteExam('${e.id}')">×</button></div>`}).join('')}</section>`}